      "parameters": {
        "assignments": [
          {
            "id": "merge-001",
            "name": "finalResult",
            "value": "={{ $json }}",
            "type": "object"
          }
        ]
      },
      "position": [1680, 60],
      "typeVersion": 3.4
    },
    {
      "id": "platform-twitter-check",
      "name": "🐦 Post to Twitter/X?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.twitter }}",
              "value2": true
            }
          ]
        }
      },
      "position": [980, -120],
      "typeVersion": 2
    },
    {
      "id": "platform-twitter-post",
      "name": "🐦 Post to Twitter/X",
      "type": "twitter",
      "parameters": {},
      "position": [1140, -20],
      "typeVersion": 2.1
    },
    {
      "id": "platform-instagram-check",
      "name": "📷 Post to Instagram?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.instagram }}",
              "value2": true
            }
          ]
        }
      },
      "position": [920, 80],
      "typeVersion": 2
    },
    {
      "id": "platform-instagram-post",
      "name": "📷 Post to Instagram",
      "type": "instagram",
      "parameters": {},
      "position": [1140, 80],
      "typeVersion": 1
    },
    {
      "id": "platform-facebook-check",
      "name": "👤 Post to Facebook?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.facebook }}",
              "value2": true
            }
          ]
        }
      },
      "position": [920, 180],
      "typeVersion": 2
    },
    {
      "id": "platform-facebook-post",
      "name": "👤 Post to Facebook Page",
      "type": "facebook",
      "parameters": {},
      "position": [1140, 180],
      "typeVersion": 2.1
    },
    {
      "id": "platform-linkedin-check",
      "name": "💼 Post to LinkedIn?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.linkedin }}",
              "value2": true
            }
          ]
        }
      },
      "position": [920, 280],
      "typeVersion": 2
    },
    {
      "id": "platform-linkedin-post",
      "name": "💼 Post to LinkedIn",
      "type": "linkedIn",
      "parameters": {},
      "position": [1140, 280],
      "typeVersion": 2
    },
    {
      "id": "platform-email-check",
      "name": "📧 Send Email?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.email && $json.emailRecipients && $json.emailRecipients.length > 0 }}",
              "value2": true
            }
          ]
        }
      },
      "position": [920, 380],
      "typeVersion": 2
    },
    {
      "id": "platform-email-send",
      "name": "📧 Send Email",
      "type": "emailSend",
      "parameters": {
        "fromEmail": "={{ $env.EMAIL_FROM || 'noreply@example.com' }}",
        "toEmail": "={{ $json.emailRecipients.join(',') }}",
        "subject": "={{ $json.eventTitle }} - {{ $json.formattedDate }}",
        "html": "={{ $json.emailHtml }}",
        "options": {
          "attachments": "={{ $json.imageUrl ? [{ url: $json.imageUrl, name: 'event-image.jpg' }] : [] }}"
        }
      },
      "position": [1140, 380],
      "typeVersion": 2.1
    },
    {
      "id": "platform-reddit-check",
      "name": "🔴 Post to Reddit?",
      "type": "if",
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.publishTo.reddit && $json.redditSubreddit }}",
              "value2": true
            }
          ]
        }
      },
      "position": [920, 620],
      "typeVersion": 2
    },
    {
      "id": "platform-reddit-post",
      "name": "🔴 Post to Reddit",
      "type": "httpRequest",
      "parameters": {
        "method": "POST",
        "url": "https://oauth.reddit.com/api/submit",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "={{ $env.REDDIT_USER_AGENT || 'n8n-workflow/1.0' }}"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "sr",
              "value": "={{ $json.redditSubreddit }}"
            },
            {
              "name": "title",
              "value": "={{ $json.eventTitle }}"
            },
            {
              "name": "text",
              "value": "={{ $json.redditText }}"
            },
            {
              "name": "kind",
              "value": "={{ $json.redditPostType || 'self' }}"
            },
            {
              "name": "nsfw",
              "value": "={{ $json.redditNsfw ? 'true' : 'false' }}"
            },
            {
              "name": "spoiler",
              "value": "={{ $json.redditSpoiler ? 'true' : 'false' }}"
            },
            {
              "name": "flair_text",
              "value": "={{ $json.redditFlair || '' }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "position": [1140, 620],
      "typeVersion": 4.2
    }
  ],
