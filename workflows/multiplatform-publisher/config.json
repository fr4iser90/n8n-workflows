{
  "name": "Multi-Platform Social Media Publisher",
  "description": "Publish DJ events to multiple social media platforms simultaneously",
  "version": "1.0.0",
  "author": "fr4iser",
  "platforms": ["twitter", "instagram", "facebook", "linkedin", "reddit", "email"],
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "📥 Webhook Trigger",
      "type": "webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "dj-event",
        "responseMode": "responseNode"
      },
      "position": [260, 80],
      "webhookId": "dj-event-webhook"
    },
    {
      "id": "webhook-response",
      "name": "✅ Webhook Response",
      "type": "respondToWebhook",
      "parameters": {
        "respondWith": "allIncomingItems"
      },
      "position": [2560, 0]
    },
